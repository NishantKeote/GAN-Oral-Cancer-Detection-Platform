# ==============================================================================
# Environment Configuration Template for OSCC GraphRAG Backend
# Duplicate this file as '.env' and populate with your local values.
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list)
# Default includes Vite dev server (5173) and React default (3000)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Model and Knowledge Base Resource Paths
# Paths can be absolute or relative to the backend/ working directory
MODEL_PATH=../models/best_efficientnetb0.keras
FAISS_PATH=../knowledge_base/oscc_literature.faiss
METADATA_PATH=../knowledge_base/chunk_metadata.json
ARTIFACT_DIR=./artifacts

# Classification Settings
# Threshold optimized during training to balance sensitivity and specificity
CLASSIFICATION_THRESHOLD=0.850266
MAX_UPLOAD_BYTES=20971520

# Neo4j Graph Database Credentials (Optional / External)
# Leave as placeholder or configure for graph traversal and case persistence
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Groq LLM API Credentials (Optional / External)
# Required for generating grounded research reports
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile
